# Application
NODE_ENV=development
APP_NAME=sofa-api
APP_HOST=0.0.0.0
APP_PORT=8083
API_PREFIX=api
API_VERSION=1
# Set true when Nest sits behind nginx (or any reverse proxy)
TRUST_PROXY=true

# Logging (pretty defaults to true outside production)
LOG_LEVEL=debug
LOG_PRETTY=true

# HTTP (nginx edge + Sofa Vite app). Include both if SPA sometimes calls Nest directly.
CORS_ORIGINS=http://localhost:8089,http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=true
BODY_LIMIT=1mb
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_BASIC_USER=
SWAGGER_BASIC_PASSWORD=

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# MySQL (docker compose defaults; port offset avoids Ticketor v2)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=sofa
MYSQL_PASSWORD=sofa_secret
MYSQL_DATABASE=sofa
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_SYNC=false
MYSQL_LOGGING=true
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6382
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=sofa:
REDIS_TLS=false

# PUBLIC_APP_URL = single browser origin (nginx edge) for SuperTokens cookies, invites, CORS.
# Do not set FRONTEND_URL; if present it must match PUBLIC_APP_URL exactly.
PUBLIC_APP_URL=http://localhost:8089
NGINX_HTTP_PORT=8089

# SuperTokens (self-hosted Core). Must match frontend VITE_SUPERTOKENS_* and Core API_KEYS.
# Generate: openssl rand -hex 32
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3568
SUPERTOKENS_API_KEY=dev-only-change-me-supertokens-api-key-32chars
SUPERTOKENS_API_DOMAIN=http://localhost:8089
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_APP_NAME=Sofa
# Optional: comma-separated emails with dashboard write access (empty = all dashboard users can write)
SUPERTOKENS_DASHBOARD_ADMINS=
SUPERTOKENS_CORE_PORT=3568
SUPERTOKENS_DB_USER=supertokens
SUPERTOKENS_DB_PASSWORD=supertokens_secret
SUPERTOKENS_DB_NAME=supertokens
# Pin in prod: registry or Docker Hub immutable tag (avoid :latest)
SUPERTOKENS_IMAGE=supertokens/supertokens-postgresql:12.5.0
# Access token lifetime in seconds (SuperTokens Core). 900 = 15 minutes (default Core is 3600 = 1 hour).
SUPERTOKENS_ACCESS_TOKEN_VALIDITY_SECONDS=900
# Refresh token lifetime in minutes (SuperTokens Core). 10080 = 7 days (default Core is 144000 = 100 days).
SUPERTOKENS_REFRESH_TOKEN_VALIDITY_MINUTES=10080

# Google OAuth (SuperTokens ThirdParty). Leave empty to disable "Continue with Google".
# Google Cloud Console → OAuth 2.0 Client (Web). Authorized redirect URI:
#   {PUBLIC_APP_URL}/login/callback/google
# (SPA route — do not use /auth/callback; nginx sends /auth/* to Nest SuperTokens.)
# Keep secrets out of git; set both in every environment that enables Google login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email (Gmail SMTP primary, Resend fallback)
EMAIL_PRIMARY_PROVIDER=gmail
EMAIL_FALLBACK_PROVIDER=resend
EMAIL_FROM_ADDRESS=noreply@sofa.local
EMAIL_FROM_NAME=Sofa

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_APP_PASSWORD=

RESEND_API_KEY=

# ClamAV clamd — fail closed when enabled (docker compose service clamav)
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3311
CLAMAV_TIMEOUT_MS=60000

# Local MinIO (docker compose service minio)
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sofa-documents
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_PUT_EXPIRES_SECONDS=900
S3_PRESIGN_GET_EXPIRES_SECONDS=300
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# Document upload limits
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_SCAN_MAX_ATTEMPTS=5

# Kafka (docker compose service kafka) — document scan topic
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_PORT=9094
KAFKA_CLIENT_ID=sofa-api
KAFKA_SSL=false
KAFKA_DOCUMENT_SCAN_TOPIC=sofa.document.scan
KAFKA_DOCUMENT_SCAN_GROUP_ID=sofa-document-scan

FRONTEND_URL=http://localhost:8089

# Third-party integrations (Jira / Linear / GitHub; Slack later)
# Feature flag — keep false until OAuth credentials are configured
JIRA_INTEGRATION_ENABLED=false
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Must match Atlassian app callback and hit nginx edge
JIRA_CALLBACK_URL=http://localhost:8089/api/v1/integrations/jira/callback
# Scopes: read:jira-user, read:jira-work, write:jira-work, offline_access.
# Enable the same on the Atlassian Developer Console, then reconnect.

LINEAR_INTEGRATION_ENABLED=false
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Must match Linear OAuth app callback and hit nginx edge
LINEAR_CALLBACK_URL=http://localhost:8089/api/v1/integrations/linear/callback
# Scopes: read,issues:create (comma-separated on the authorize URL).

# GitHub App (not a legacy OAuth App). Keep false until the App is registered.
GITHUB_INTEGRATION_ENABLED=false
GITHUB_APP_ID=
# From https://github.com/apps/{slug} — enables install+OAuth connect URL
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM private key; use \n-escaped single line in .env (including BEGIN/END lines).
GITHUB_PRIVATE_KEY=
# Must match GitHub App "Callback URL" and hit nginx edge
GITHUB_CALLBACK_URL=http://localhost:8089/api/v1/integrations/github/callback

# Asana OAuth app (https://app.asana.com/0/my-apps). Keep false until registered.
ASANA_INTEGRATION_ENABLED=false
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Must match Asana OAuth redirect URL and hit nginx edge
ASANA_CALLBACK_URL=http://localhost:8089/api/v1/integrations/asana/callback
# Scopes (space-separated on authorize URL): workspaces:read projects:read tasks:write users:read tags:read

INTEGRATION_CREDENTIALS_SECRET=dev-only-change-me-integration-credentials!!
